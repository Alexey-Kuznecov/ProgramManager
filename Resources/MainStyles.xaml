<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ProgramManager.Converters">

    <!--  СТИЛИ ДЛЯ ИКОНОК ПАКЕТОВ ГЛАВНОГО ОКНА ПАКЕТОВ  -->

    <Style x:Key="IconStylesMain" TargetType="ContentControl">
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="5" />
    </Style>

    <ControlTemplate x:Key="IconTemplateMain" TargetType="ContentControl">
        <ControlTemplate.Resources>
            <converters:ContentConverter x:Key="ContentConverter" />
            <converters:BrushConverter x:Key="BrushConverter" />
        </ControlTemplate.Resources>
        <Grid x:Name="grid">
            <Path Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource BrushConverter}, ConverterParameter=rect}" Stretch="Uniform">
                <Path.Data>
                    <RectangleGeometry Rect="0,0,50,50" />
                </Path.Data>
            </Path>
            <Path
                Width="32"
                Height="32"
                Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource ContentConverter}}"
                Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource BrushConverter}, ConverterParameter=shape}"
                Stretch="Uniform" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="InfoPanelTabsStyle" TargetType="TabItem">
        <Border
            x:Name="Border"
            Padding="5"
            Background="AliceBlue"
            BorderBrush="AliceBlue"
            Cursor="Hand">
            <TextBlock
                x:Name="TextBlock"
                Width="60"
                Height="15"
                Foreground="Black"
                Text="{TemplateBinding Header}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#4DCCCCFF" />
                <Setter TargetName="Border" Property="Background" Value="#4DCCCCFF" />
                <Setter TargetName="TextBlock" Property="Foreground" Value="Black" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="InfoPanelNewTabStyle" TargetType="TabItem">
        <Border
            x:Name="Border"
            Padding="5"
            Background="#4CAF50"
            BorderBrush="AliceBlue"
            Cursor="Hand">
            <Image
                Width="24"
                Height="24"
                Source="../Resources/Icons/Add_48px.png" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#4DCCCCFF" />
                <Setter TargetName="Border" Property="Background" Value="#4DCCCCFF" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>