<Window
    x:Class="ProgramManager.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:ProgramManager.Views.SettingsControl"
    xmlns:vm="clr-namespace:ProgramManager.ViewModels"
    Title="SettingsView"
    Width="800"
    Height="500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <TreeView FontSize="12">
                <TreeViewItem Header="Основыне" IsSelected="True">
                    <TreeViewItem.InputBindings>
                        <MouseBinding
                            Command="{Binding GeneralSettings}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Gesture="LeftClick" />
                    </TreeViewItem.InputBindings>
                </TreeViewItem>

                <TreeViewItem Header="Темы" IsExpanded="True">
                    <TreeViewItem Header="Значки">
                        <TreeViewItem.InputBindings>
                            <MouseBinding Command="{Binding ThemesSettings}" Gesture="LeftClick" />
                        </TreeViewItem.InputBindings>
                    </TreeViewItem>
                    <TreeViewItem Header="Цветовая схема" />
                    <TreeViewItem Header="Иконки пакетов" />
                    <TreeViewItem Header="Ассоциации" />
                </TreeViewItem>
                <TreeViewItem Header="Пакеты" />
                <TreeViewItem Header="Модули" />
                <TreeViewItem Header="Службы" IsExpanded="True">
                    <TreeViewItem Header="Запуск программ" />
                    <TreeViewItem Header="Установка программ" />
                    <TreeViewItem Header="Обновление программ" />
                </TreeViewItem>
                <TreeViewItem Header="Плагины" IsExpanded="True">
                    <TreeViewItem Header="Настройки плагинов">
                        <TreeViewItem.InputBindings>
                            <MouseBinding Command="{Binding PluginSettings}" Gesture="LeftClick" />
                        </TreeViewItem.InputBindings>
                    </TreeViewItem>
                    <TreeViewItem Header="Редактор иконок" />
                    <TreeViewItem Header="Редактор тегов" />
                    <TreeViewItem Header="Редактор скриптов" />
                    <TreeViewItem Header="Редактор клавиш" />
                </TreeViewItem>
                <TreeViewItem Header="Горячие клавиши" />
                <TreeViewItem Header="Фильтры" />
                <TreeViewItem Header="Поиск" />
                <TreeViewItem Header="Разное" />
            </TreeView>
        </ScrollViewer>
        <Grid Grid.Row="1" Grid.Column="1">
            <ContentPresenter Margin="10" Content="{Binding SettingsView}" />
        </Grid>
    </Grid>
</Window>
