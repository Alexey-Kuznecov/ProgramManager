<Window
    x:Class="ProgramManager.Views.IconsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProgramManager.ViewModels"
    Title="IconsEditor"
    Width="700"
    Height="480"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="Styles"
            BasedOn="{StaticResource IconStylesEditor}"
            TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{Binding SelectedItem.Content, ElementName=ComboBox}" />
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:IconEditorViewModel />
    </Window.DataContext>
    <Grid Background="{Binding Background, ElementName=window}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="170*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*" />
            <RowDefinition Height="40*" />
            <RowDefinition Height="220*" />
            <RowDefinition Height="43*" />
        </Grid.RowDefinitions>
        <Menu
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#FFE6E6E6">
            <MenuItem FontSize="12" Header="Файл">
                <MenuItem Command="{Binding OpenFileIconCommand}" Header="Открыть" />
                <MenuItem Header="Сохранить" />
                <Separator />
                <MenuItem Command="{Binding Shutdown}" Header="Закрыть" />
            </MenuItem>
            <MenuItem FontSize="12" Header="Вид">
                <MenuItem Header="Список" />
                <MenuItem Header="Плитка" />
                <MenuItem Header="Карточки" />
            </MenuItem>
            <MenuItem FontSize="12" Header="Инструменты">
                <MenuItem Header="Ресурсы" />
                <MenuItem Header="Палитра" />
                <MenuItem Header="Форматер" />
                <MenuItem Header="Плагины" />
            </MenuItem>
        </Menu>
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Height="35"
            Margin="15,5"
            FontSize="16"
            FontStyle="Italic"
            Tag="Имя..."
            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ListBox
            x:Name="ListBox"
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            ItemsSource="{Binding IconCategory}"
            Style="{StaticResource ListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock ContextMenu="{Binding NameContextMenu}" Text="{Binding CollectionName}">
                        <!--<TextBlock.ContextMenu>
                            <ContextMenu>
                                <ContextMenu.DataContext>
                                    <vm:IconEditorViewModel FilterText="ss" IconBrush="{StaticResource IdiaIcon}" x:Name="IconEditorViewModel" />
                                </ContextMenu.DataContext>
                                <MenuItem Command="{Binding OpenFileIconCommand}" Header="Добавить иконку" />
                                <MenuItem Header="Добавить категорию" />
                                <MenuItem Header="Добавить разделитель" />
                                <MenuItem Header="Переименовать" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>-->
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Buttons, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Cursor="Hand" Header="Установить" />
                                    <MenuItem
                                        Command="{Binding RanameIcon}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand"
                                        Header="Переименовать" />
                                    <MenuItem
                                        Command="{Binding RemoveIcon}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand"
                                        Header="Удалить" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Button
                                x:Name="d"
                                Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"
                                CommandParameter="{Binding CommandParameter}"
                                Content="{Binding Path}"
                                Style="{StaticResource Styles}"
                                Template="{StaticResource IconTemplateEditor}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <ContentControl
                                                Width="100"
                                                Height="100"
                                                Content="{Binding Path}"
                                                Foreground="{Binding Color}"
                                                Template="{StaticResource IconTemplateEditorTooltip}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Padding="3"
                                                Background="#F3F3EC"
                                                Foreground="#3C3C3B"
                                                Text="{Binding IconName}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="20,10,10,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
        <Grid
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="30"
            Margin="10,10,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200*" />
                <ColumnDefinition Width="200*" />
                <ColumnDefinition Width="105*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ComboBox"
                Width="200"
                VerticalContentAlignment="Center"
                SelectedIndex="0"
                SelectedItem="{Binding ColorBrush}">
                <ComboBoxItem Content="#FF1A1E24" />
                <ComboBoxItem Content="#ee2c2c00" />
                <ComboBoxItem Content="#FF72f534" />
                <ComboBoxItem Content="#FF184B9C" />
                <ComboBoxItem Content="#FFffcd09" />
                <ComboBoxItem Content="#FF0c6eb7" />
                <ComboBoxItem Content="#FF9b993a" />
                <ComboBoxItem Content="#FFbb4b9c" />
                <ComboBoxItem Content="#FFf68f4d" />
                <ComboBoxItem Content="#FF78c696" />
                <ComboBoxItem Content="#FFf59eb3" />
                <ComboBoxItem Content="#FFc5a3cc" />
                <ComboBoxItem Content="#FFcec82b" />
                <ComboBoxItem Content="#FFe0b03a" />
                <ComboBoxItem Content="#FF8d663a" />
                <ComboBoxItem Content="#FF028d5b" />
                <ComboBoxItem Content="#FF89d3de" />
                <ComboBoxItem Content="#FF672f8f" />
            </ComboBox>
            <Button
                Grid.Column="2"
                Command="{Binding ResetByDefault}"
                CommandParameter="{Binding ItemTemplate.Template, ElementName=ccc}"
                Content="Сбросить" />
        </Grid>
    </Grid>
</Window>

