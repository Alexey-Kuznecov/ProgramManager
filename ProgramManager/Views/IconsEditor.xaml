<Window
    x:Class="ProgramManager.Views.IconsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProgramManager.ViewModels"
    Title="IconsEditor"
    Width="800"
    Height="520"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="Styles"
            BasedOn="{StaticResource IconStylesEditor}"
            TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{Binding SelectedItem.Content, ElementName=ComboBox}" />
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:IconEditorViewModel />
    </Window.DataContext>
    <Grid Background="{Binding Background, ElementName=window}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="170*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*" />
            <RowDefinition Height="40*" />
            <RowDefinition Height="220*" />
            <RowDefinition Height="43*" />
        </Grid.RowDefinitions>
        <Menu
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#FFFFFF">
            <MenuItem FontSize="12" Header="Файл">
                <MenuItem Command="{Binding OpenFileIconCommand}" Header="Открыть" />
                <MenuItem Header="Сохранить" />
                <Separator />
                <MenuItem Command="{Binding Shutdown}" Header="Закрыть" />
            </MenuItem>
            <MenuItem FontSize="12" Header="Вид">
                <MenuItem Header="Список" />
                <MenuItem Header="Плитка" />
                <MenuItem Header="Карточки" />
            </MenuItem>
            <MenuItem FontSize="12" Header="Инструменты">
                <MenuItem Header="Ресурсы" />
                <MenuItem Header="Палитра" />
                <MenuItem Header="Форматер" />
                <MenuItem Header="Плагины" />
            </MenuItem>
        </Menu>
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Width="300"
            Height="35"
            Margin="10,11,246,9"
            FontSize="16"
            FontStyle="Italic"
            Tag="Имя..."
            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <!--<TextBox.InputBindings>
                <KeyBinding Command="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Gesture="back" />
            </TextBox.InputBindings>-->
        </TextBox>

        <ListBox
            x:Name="ListBox"
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            ItemsSource="{Binding IconCategory}"
            SelectedIndex="{Binding SelectIndex, Mode=TwoWay}"
            SelectedItem="{Binding SelectItem, Mode=TwoWay}"
            Style="{StaticResource ListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ContentControl
                        Width="180"
                        Height="30"
                        VerticalAlignment="Center">
                        <TextBlock
                            Height="30"
                            Padding="5"
                            ContextMenu="{Binding NameContextMenu}"
                            Cursor="Hand"
                            Text="{Binding CollectionName}" />
                        <ContentControl.InputBindings>
                            <MouseBinding
                                Command="{Binding FilterCollection}"
                                CommandParameter="{Binding CollectionName}"
                                Gesture="LeftClick" />
                        </ContentControl.InputBindings>
                    </ContentControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="1"
            VerticalScrollBarVisibility="Visible">
            <ItemsControl ItemsSource="{Binding Buttons, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Cursor="Hand" Header="Установить" />
                                    <MenuItem
                                        Command="{Binding RanameIcon}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand"
                                        Header="Переименовать" />
                                    <MenuItem
                                        Command="{Binding RemoveIcon}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand"
                                        Header="Удалить" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Button
                                x:Name="d"
                                Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"
                                CommandParameter="{Binding CommandParameter}"
                                Content="{Binding Path}"
                                Style="{StaticResource Styles}"
                                Template="{StaticResource IconTemplateEditor}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <ContentControl
                                                Width="100"
                                                Height="100"
                                                Content="{Binding Path}"
                                                Foreground="{Binding Color}"
                                                Template="{StaticResource IconTemplateEditorTooltip}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Padding="3"
                                                Background="#F3F3EC"
                                                Foreground="#3C3C3B"
                                                Text="{Binding IconName}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="20,10,10,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
        <Grid
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#EDEDED">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="200*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ComboBox"
                Width="200"
                Height="35"
                VerticalContentAlignment="Center"
                Cursor="Hand"
                SelectedIndex="0"
                SelectedItem="{Binding ColorBrush}">
                <ComboBoxItem Content="#FF1A1E24" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#ee2c2c00" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#ee2c2c00" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF79ED9A" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF184B9C" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFE1D854" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF0c6eb7" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF9b993a" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFbb4b9c" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFF17A07" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF78c696" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFf59eb3" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFc5a3cc" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFcec82b" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFe0b03a" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF8d663a" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF028d5b" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF009FE3" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF672f8f" Template="{StaticResource ComboBoxItemTemplate}" />
            </ComboBox>
            <Button
                Grid.Column="2"
                Width="100"
                Height="35"
                Command="{Binding ResetByDefault}"
                CommandParameter="{Binding ItemTemplate.Template, ElementName=ccc}"
                Content="Сбросить" />
        </Grid>
    </Grid>
</Window>

