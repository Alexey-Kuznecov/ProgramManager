<Window
    x:Class="ProgramManager.Plugins.IconsEditor.Bin.IconsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bin="clr-namespace:ProgramManager.Plugins.IconsEditor.Bin"
    xmlns:converters="clr-namespace:ProgramManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IconsEditor"
    Width="800"
    Height="520"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.DataContext>
        <bin:IconsEditorViewModel />
    </Window.DataContext>
    <Grid Background="{Binding Background, ElementName=window}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="170*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*" />
            <RowDefinition Height="40*" />
            <RowDefinition Height="220*" />
            <RowDefinition Height="70*" />
        </Grid.RowDefinitions>
        <Menu
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#FFFFFF">
            <MenuItem FontSize="12" Header="Файл">
                <MenuItem Command="{Binding AddNewIconCommand}" Header="Открыть" />
                <MenuItem Header="Сохранить" />
                <Separator />
                <MenuItem Command="{Binding Shutdown}" Header="Закрыть" />
            </MenuItem>
            <MenuItem FontSize="12" Header="Вид">
                <MenuItem Header="Список" />
                <MenuItem Header="Плитка" />
                <MenuItem Header="Карточки" />
            </MenuItem>
            <MenuItem FontSize="12" Header="Инструменты">
                <MenuItem Header="Ресурсы" />
                <MenuItem Header="Палитра" />
                <MenuItem Header="Форматер" />
                <MenuItem Header="Плагины" />
            </MenuItem>
        </Menu>
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Width="300"
            Height="35"
            Margin="10,11,246,9"
            FontSize="16"
            FontStyle="Italic"
            Tag="Имя..."
            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <!--<TextBox.InputBindings>
                <KeyBinding Command="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Gesture="back" />
            </TextBox.InputBindings>-->
        </TextBox>

        <ListBox
            x:Name="ListBox"
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            AllowDrop="True"
            ItemsSource="{Binding IconCollection}"
            SelectedIndex="{Binding SelectIndex}"
            Style="{StaticResource ListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ContentControl
                        Width="180"
                        Height="30"
                        VerticalAlignment="Center"
                        AllowDrop="True"
                        Cursor="Hand">
                        <WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Padding="5"
                                    AllowDrop="True"
                                    ContextMenu="{Binding NameContextMenu}"
                                    Cursor="Hand"
                                    Text="{Binding CollectionName}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Padding="5"
                                    Text="{Binding Icons.Count}"
                                    TextAlignment="Right" />
                            </Grid>
                        </WrapPanel>
                    </ContentControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Drop">
                    <ei:CallMethodAction MethodName="Grid_OnDrop" TargetObject="{Binding}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="DragEnter">
                    <ei:CallMethodAction MethodName="Grid_OnDragEnter" TargetObject="{Binding}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="DragOver">
                    <ei:CallMethodAction MethodName="Grid_DragOver" TargetObject="{Binding}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="MouseMove">
                    <ei:CallMethodAction MethodName="OnMouseMove" TargetObject="{Binding}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="GiveFeedback">
                    <ei:CallMethodAction MethodName="Grid_GiveFeedback" TargetObject="{Binding}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ListBox>
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="1"
            VerticalScrollBarVisibility="Visible">
            <ItemsControl ItemsSource="{Binding Buttons, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="grid">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Cursor="Hand" Header="Установить" />
                                    <MenuItem Cursor="Hand" Header="Переместить в" />
                                    <MenuItem
                                        Command="{Binding RenameIcon}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand"
                                        Header="Переименовать" />
                                    <MenuItem
                                        Command="{Binding RemoveIcon}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand"
                                        Header="Удалить" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Button
                                x:Name="d"
                                Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"
                                CommandParameter="{Binding CommandParameter}"
                                Content="{Binding Brush}"
                                DragEnter="UIElement_OnDragEnter"
                                DragOver="UIElement_OnDragOver"
                                Drop="UIElement_OnDrop"
                                GiveFeedback="UIElement_OnGiveFeedback"
                                MouseMove="UIElement_OnMouseMove"
                                Style="{Binding Style}"
                                Template="{Binding Template}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <Button
                                                Width="64"
                                                Height="64"
                                                Padding="10"
                                                Background="{Binding Brush}"
                                                BorderBrush="{x:Null}"
                                                Foreground="{x:Null}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Padding="3"
                                                Background="#F3F3EC"
                                                Foreground="#3C3C3B"
                                                Text="{Binding IconName}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="20,10,10,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>
        </ScrollViewer>
        <Grid
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#EDEDED">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="200*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.ColumnSpan="3" Background="#FFFFFF">
                <Label
                    Width="50"
                    Margin="720,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Content="{Binding ElementName=s, Path=Value}" />
            </Grid>
            <ComboBox
                x:Name="ComboBox"
                Grid.Row="1"
                Grid.Column="0"
                Width="200"
                Height="35"
                VerticalContentAlignment="Center"
                Cursor="Hand"
                SelectedIndex="0"
                SelectedItem="{Binding ColorBrush}">
                <ComboBoxItem Content="#FF3676AE" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#ee2c2c00" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF79ED9A" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF184B9C" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFE1D854" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF9b993a" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFbb4b9c" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFF17A07" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF78c696" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFf59eb3" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFc5a3cc" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFcec82b" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FFe0b03a" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF8d663a" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF028d5b" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF009FE3" Template="{StaticResource ComboBoxItemTemplate}" />
                <ComboBoxItem Content="#FF672f8f" Template="{StaticResource ComboBoxItemTemplate}" />
            </ComboBox>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40*" />
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    Height="34"
                    VerticalAlignment="Center"
                    Content="Цветные иконки"
                    Cursor="Hand"
                    IsChecked="{Binding EnableColorIcon, Mode=TwoWay}" />
                <Slider
                    x:Name="s"
                    Grid.Column="1"
                    Height="30"
                    VerticalAlignment="Center"
                    Maximum="256"
                    Minimum="12"
                    Value="36" />
            </Grid>
            <!--<Button
                Grid.Row="1"
                Grid.Column="2"
                Width="100"
                Height="35"
                Command="{Binding ResetByDefault}"
                CommandParameter="{Binding ItemTemplate.Template, ElementName=ccc}"
                Content="Сбросить" />-->
            <Grid
                Grid.Row="1"
                Grid.Column="2"
                AllowDrop="True">

                <!--
                    DragEnter="{x:Static bin:DragDrop.DragEnterHandler}"
                    DragOver="{x:Static bin:DragDrop.DragOverHandler}"
                    Drop="{x:Static bin:DragDrop.DropHandler}"
                    GiveFeedback="{x:Static bin:DragDrop.GiveFeedbackHandler}"
                    MouseMove="{x:Static bin:DragDrop.MouseMoveHandler}"
                -->

                <!--<i:Interaction.Triggers>
                    <i:EventTrigger EventName="Drop">
                        <ei:CallMethodAction MethodName="Grid_OnDrop" TargetObject="{Binding}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="DragEnter">
                        <ei:CallMethodAction MethodName="Grid_OnDragEnter" TargetObject="{Binding}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="DragOver">
                        <ei:CallMethodAction MethodName="Grid_DragOver" TargetObject="{Binding}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseMove">
                        <ei:CallMethodAction MethodName="OnMouseMove" TargetObject="{Binding}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="GiveFeedback">
                        <ei:CallMethodAction MethodName="Grid_GiveFeedback" TargetObject="{Binding}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>-->
                <ContentControl
                    Content="{Binding CurrentButtonExtension.Path}"
                    Style="{StaticResource IconStylesMain}"
                    Template="{StaticResource IconTemplateMain}" />
            </Grid>
        </Grid>

    </Grid>
</Window>

