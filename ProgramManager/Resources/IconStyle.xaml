<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:ProgramManager.Converters">

    <ControlTemplate x:Key="IconTemplate" TargetType="Button">
        <ControlTemplate.Resources>
            <converter:ContentConverter x:Key="ContentConverter" />
        </ControlTemplate.Resources>
        <Grid x:Name="grid">
            <Path
                x:Name="rect"
                Fill="{TemplateBinding Background}"
                Stretch="Uniform"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderThickness.Left}">
                <Path.Data>
                    <RectangleGeometry Rect="0,0,50,50" />
                </Path.Data>
            </Path>
            <Path
                x:Name="shape"
                Width="32"
                Height="32"
                Data="{TemplateBinding Content,
                                       Converter={StaticResource ContentConverter}}"
                Fill="{TemplateBinding Foreground}"
                Stretch="Uniform" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shape" Property="Fill" Value="#FFFFFF" />
                <Setter TargetName="rect" Property="Fill" Value="{Binding RelativeSource={RelativeSource Self}, Path=Stroke}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="IconStyle2" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <!--  ИКОНКИ  -->
                <ControlTemplate TargetType="ContentControl">
                    <ControlTemplate.Resources>
                        <converter:ContentConverter x:Key="ContentConverter" />
                        <converter:BrushConverter x:Key="BrushConverter" />
                    </ControlTemplate.Resources>
                    <Grid x:Name="grid">
                        <Path Fill="{TemplateBinding Content, Converter={StaticResource BrushConverter}, ConverterParameter=rect}" Stretch="Uniform">
                            <Path.Data>
                                <RectangleGeometry Rect="0,0,50,50" />
                            </Path.Data>
                        </Path>
                        <Path
                            Width="32"
                            Height="32"
                            Data="{TemplateBinding Content,
                                                   Converter={StaticResource ContentConverter}}"
                            Fill="{TemplateBinding Content,
                                                   Converter={StaticResource BrushConverter},
                                                   ConverterParameter=shape}"
                            Stretch="Uniform" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="5" />
    </Style>
</ResourceDictionary>