<UserControl
    x:Class="ProgramManager.Views.MainControls.InfoPanelPostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <Image
            Grid.Row="0"
            Grid.Column="0"
            Height="400"
            Source="../../Resources/User/Images/GeraltFromRivia.png"
            Stretch="Uniform" />
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,10">
            <Button
                Width="16"
                Height="16"
                BorderBrush="{x:Null}"
                BorderThickness="0">
                <Button.Background>
                    <DrawingBrush Stretch="Uniform">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <DrawingGroup.Children>
                                    <GeometryDrawing Brush="Black" Geometry="M70.3488,37.7757C52.5504,-12.5919 58.3303,-12.5919 40.5319,37.7757 -12.8633,39.1519 -11.0896,33.6472 31.3269,66.1553 16.1279,117.349 11.4489,113.954 55.4556,83.6784 99.4623,113.954 94.7834,117.349 79.5844,66.1553 121.97,33.6472 123.744,39.1519 70.3488,37.7757z" />
                                </DrawingGroup.Children>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Button.Background>
            </Button>
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="0"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="5">
                <ItemsControl ItemsSource="{Binding CurrentPackage.TextField, Mode=Default}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition />
                                    <RowDefinition Height="10" />
                                </Grid.RowDefinitions>
                                <Label Content="{Binding Label, Mode=Default, StringFormat={}{0}:}" FontWeight="Bold" />
                                <Label
                                    Name="PackageName"
                                    Grid.Row="1"
                                    Content="{Binding FieldValue, Mode=Default}" />
                                <Separator
                                    Grid.Row="2"
                                    Background="#FFF3F3F3"
                                    BorderBrush="Azure" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Label Content="Описание" FontWeight="Bold" />
                <Label Height="64" Content="{Binding CurrentPackage.Description, Mode=Default}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
