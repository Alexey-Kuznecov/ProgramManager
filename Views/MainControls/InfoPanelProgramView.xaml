<UserControl
    x:Class="ProgramManager.Views.MainControls.InfoPanelProgramView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AlexLibWpf.Converters;assembly=AlexLibWpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProgramManager.Views.MainControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Width="60"
            Height="60"
            Margin="15"
            HorizontalAlignment="Right"
            BorderBrush="AliceBlue"
            BorderThickness="4">
            <Button Command="{Binding CommandOpenIconEditor, Mode=Default}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <converters:ContentConverter x:Key="ContentConverter" />
                        </ControlTemplate.Resources>
                        <Grid>
                            <Path
                                x:Name="rect"
                                Fill="{Binding CurrentPackage.Icon.BackgroundColor, Mode=Default}"
                                Stretch="Uniform">
                                <Path.Data>
                                    <RectangleGeometry Rect="0,0,50,50" />
                                </Path.Data>
                            </Path>
                            <Path x:Name="overRect" Stretch="Uniform">
                                <Path.Data>
                                    <RectangleGeometry Rect="0,0,40,40" />
                                </Path.Data>
                            </Path>
                            <Path
                                x:Name="shape"
                                Width="24"
                                Height="24"
                                Data="{Binding CurrentPackage.Icon.Path, Converter={StaticResource ContentConverter}, Mode=Default}"
                                Fill="{Binding CurrentPackage.Icon.ForegroundColor, Mode=Default}"
                                Stretch="Uniform" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overRect" Property="Fill" Value="#4DCCCCFF" />
                                <Setter TargetName="shape" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="5">
                <ItemsControl ItemsSource="{Binding CurrentPackage.TextField, Mode=Default}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10" />
                                    <RowDefinition />
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>
                                <Separator
                                    Grid.Row="0"
                                    Background="#FFF3F3F3"
                                    BorderBrush="Azure" />
                                <Label
                                    Grid.Row="1"
                                    Content="{Binding Label, Mode=Default, StringFormat={}{0}:}"
                                    FontWeight="Bold" />
                                <Label
                                    Name="PackageName"
                                    Grid.Row="2"
                                    Content="{Binding FieldValue, Mode=Default}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Background="#FFF3F3F3" BorderBrush="Azure" />
                <Label Content="Описание" FontWeight="Bold" />
                <Label Height="64" Content="{Binding CurrentPackage.Description, Mode=Default}" />
            </StackPanel>
        </ScrollViewer>
        <!--  Понель состояния  -->
        <StackPanel
            Grid.Row="2"
            Margin="5,0,0,10"
            HorizontalAlignment="Center">
            <Button
                x:Name="Intstall"
                Width="100"
                Height="30"
                Margin="5,10,5,10"
                Command="{Binding CommandTestCommand, Mode=Default}"
                Content="Установить" />
            <Rectangle Width="240" Height="1" />
        </StackPanel>
        <!--  Понель состояния  -->
        <WrapPanel
            Grid.Row="3"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Label Content="Установлено: 5" FontSize="11" />
            <Label Content="Пакеты: 13" FontSize="11" />
        </WrapPanel>
    </Grid>
</UserControl>
